post_install() {
    echo "================================================================================"
    echo "  :: Mithrandir-RS v0.4.2 (Rust Edition) installed successfully! 🦀"
    echo "  :: Native GTK4 & Libadwaita GNU/Linux Optimizer, Cleaner & Power Saver"
    echo "================================================================================"
    echo "  * Launch the application:          mithrandir-rs"
    echo "  * Start in system tray icon:       mithrandir-rs --background"
    echo "  * Hardware Power Saver udev rules: /usr/lib/udev/rules.d/99-mithrandir-power.rules"
    echo "================================================================================"
}

post_upgrade() {
    post_install
}
